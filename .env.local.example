# ============================================================
# Sneaker Air — Environment Variables (example)
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# ============================================================

# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Resend (transactional email)
RESEND_API_KEY=YOUR_RESEND_API_KEY
# Address customer/admin order emails are sent to / from (must be a verified
# Resend domain in production).
ADMIN_EMAIL=hello@sneakerair.com
ORDERS_FROM_EMAIL=orders@sneakerair.com

# Admin Password Hash (bcrypt) — this is what the admin login checks against.
# Generate: node -e "const bcrypt=require('bcryptjs'); bcrypt.hash('YourStrongPassword', 12).then(h => console.log(h))"
ADMIN_PASSWORD_HASH=REPLACE_WITH_YOUR_OWN_BCRYPT_HASH

# Stripe
STRIPE_SECRET_KEY=sk_live_or_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_...
# Webhook signing secret from the Stripe dashboard (Developers > Webhooks).
# Required — the /api/webhooks/stripe route verifies signatures against it.
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL (used for checkout redirects, sitemap, emails). Set to your real domain in prod.
NEXT_PUBLIC_SITE_URL=https://sneakerair.com

# ===========================================
# ADMIN SECURITY
# ===========================================

# Secret admin URL slug. The admin panel lives at /<this-slug>. Use a long,
# random value — do NOT use a guessable word or your brand/domain name.
# Generate with: node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
ADMIN_SECRET_URL=change-me-to-a-random-slug

# IP addresses allowed to reach the admin panel (comma-separated). Optional
# secondary layer on top of the device gate below.
# Leave EMPTY to allow all IPs (dev only).
# Example: "203.0.113.10,198.51.100.4"
ADMIN_ALLOWED_IPS=

# ===========================================
# TRUSTED-DEVICE GATE
# ===========================================
# Even with the slug + password, the admin area is unreachable from a device
# that hasn't been explicitly enrolled. Visit, once per trusted device (your
# laptop, phone, store PC), in that device's browser:
#   https://your-site.com/api/admin/enroll?key=<ADMIN_DEVICE_SECRET>
# It sets a 1-year httpOnly cookie on that device. Every other device gets a
# fake 404, regardless of what they know.
#
# IMPORTANT: if either var below is unset in production, the gate FAILS CLOSED
# (admin becomes unreachable from everywhere) rather than failing open — set
# BOTH before deploying, on every Vercel environment (Production AND Preview).
#
# ADMIN_DEVICE_SECRET — a passphrase used only in the enroll URL above.
# Generate: node -e "console.log('enroll-'+require('crypto').randomBytes(6).toString('hex'))"
ADMIN_DEVICE_SECRET=change-me-to-a-random-enrollment-passphrase

# ADMIN_DEVICE_TOKEN — the high-entropy value actually stored in the cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# To revoke ALL enrolled devices at once, rotate this value and redeploy.
ADMIN_DEVICE_TOKEN=change-me-to-a-random-64-char-hex-token
